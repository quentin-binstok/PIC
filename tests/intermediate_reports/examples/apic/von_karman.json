{
	"solver": "apic",
	"iteration_algo": "SOR",
	"sampling_rate": 5,
	"log_file": "log.txt",
	"metrics_file": "metrics_APIC_VK.csv",
	"dir": "apic_von_karman",
	"flip": 0.0,

	"grid": [200, 100],
	"space_steps": 5e-3,
	"nt": 2500,
	"delta_t": 0.001,
	"tol": 1e-2,
	"max_iter": 1e5,
	"rho": 1000.0,

	"gravity": false,
	"g": 9.81,

	"bc": [
		{
			"side": 0,
			"type": 3.0,
			"speed_x": 1.0
		},
		{
			"side": 1,
			"type": 2.0
		},
		{
			"side": 2,
			"type": 1.0
		},
		{
			"side": 3,
			"type": 1.0
		}
	],

	"ic_cylinders": [
		{
			"center": [50, 50],
			"radius": 10
		}
	],

	"ic_cell": [],

	"particle_density": 25,
	"refill": true,

	"metrics": [
		{
			"header": "vx",
			"idx": [20, 50],
			"print": true
		},
		{
			"header": "pressure",
			"idx": [20, 50],
			"print": true
		},
		{
			"header": "singularity_count",
			"print": true
		}
	],

	"fields": ["temperature"],

	"temperature": [
		{
			"tl": [10, 40],
			"br": [35, 60],
			"value": 5.0
		}
	]
}
