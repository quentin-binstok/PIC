{
	"solver": "semi-lagrangian",
	"iteration_algo": "SOR",
	"sampling_rate": 10,
	"log_file": "log.txt",
	"metrics_file": "metrics_APIC_VK.csv",
	"dir": "../VK_normal",
	"flip": 0.0,

	"grid": [200,200],
	"space_steps": 0.015708,
	"nt": 5000,
	"delta_t": 0.001,
	"tol": 1e-2,
	"max_iter": 1e5,
	"rho": 1000.0,

	"gravity": false,
	"g": 9.81,

	"bc": [
		{
			"side": 0,
			"type": 1.0
		},
		{
			"side": 1,
			"type": 1.0
		},
		{
			"side": 2,
			"type": 1.0
		},
		{
			"side": 3,
			"type": 1.0
		}
	],

	"ic_cylinders": [],

	"ic_cell": [],

	"taylor_green": [
		{
			"Uinf": 1.0,
			"wavenumber": 1.0
		}
	],

	"particle_density": 25,
	"refill": true,

	"metrics" : [
		{
			"header": "vx",
			"idx": [25, 10],
			"print": true
		},
		{
			"header": "vy",
			"idx": [25, 10],
			"print": true
		},
		{
			"header": "aero_coefficients",
			"rho": 1000.0,
			"A_ref": 0.06,
			"U_inf": 2.5,
			"print": true
		},
		{
			"header": "singularity_count",
			"print": true
		}
	],

	"fields": ["temperature"],

	"temperature": [
		{
			"tl": [10, 40],
			"br": [35, 60],
			"value": 5.0
		}
	]
}