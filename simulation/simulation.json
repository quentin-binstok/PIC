{
	"solver": "apic",
	"iteration_algo": "SOR",
	"sampling_rate": 10,
	"log_file": "log.txt",
	"metrics_file": "metrics_APIC.csv",
	"dir": "../dam_break_PIC_95",
	"flip": 1.0,

	"grid": [500, 500],
	"space_steps": 5e-3,
	"nt": 5000,
	"delta_t": 0.001,
	"tol": 1e-2,
	"max_iter": 1e5,
	"rho": 1000.0,

	"gravity": true,
	"g": 9.81,

	"bc": [
		{
			"side": 0,
			"type": 1.0
		},
		{
			"side": 1,
			"type": 1.0
		},
		{
			"side": 2,
			"type": 2.0
		},
		{
			"side": 3,
			"type": 1.0
		}
	],

	"ic_cylinders": [],

	"ic_cell": [
		{
			"tl": [1, 1],
			"br": [498, 499],
			"value": 2.0
		},
		{
			"tl": [1, 1],
			"br": [250, 250],
			"value": 0.0
		}
	],

	"particle_density": 25,
	"refill": false,

	"metrics" : [
		{
			"header": "volume",
			"print": true
		},
		{
			"header": "free_surface_area",
			"print": true
		},
		{
			"header": "vx",
			"idx": [10, 20],
			"print": false
		},
		{
			"header": "pressure",
			"idx": [25, 30],
			"print": false
		}
	],

	"fields": ["temperature"],

	"temperature": [
		{
			"tl": [10, 40],
			"br": [35, 60],
			"value": 5.0
		}
	]
}
